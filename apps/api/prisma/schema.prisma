generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ADMIN
  EMPLEADO
}

enum Especialidad {
  MECANICO
  ELECTRICO
  PINTOR
  MANTENIMIENTO_GENERAL
  OTRO
}

enum EstadoMaquina {
  COMPRADA_ITALIA
  EN_TRANSITO
  RECIBIDA
  EN_DIAGNOSTICO
  EN_MANTENIMIENTO
  LISTA_PARA_VENTA
  RESERVADA
  VENDIDA
}

enum EtapaImagen {
  EMBARQUE
  LLEGADA
  OTRA
}

enum TipoIntervencion {
  DIAGNOSTICO_INICIAL
  TRABAJO_REALIZADO
  OBSERVACION_ADICIONAL
}

enum AreaIntervencion {
  MECANICA
  ELECTRICA
  PINTADO
  MANTENIMIENTO_GENERAL
}

enum EstadoPedido {
  PENDIENTE
  EN_PROCESO
  ENTREGADO
  CANCELADO
}

enum EstadoIntervencion {
  ASIGNADO
  EN_PROCESO
  FINALIZADO
  APROBADO
  RECHAZADO
  CANCELADO
}

enum EstadoAprobacion {
  PENDIENTE
  APROBADO
  RECHAZADO
}

model Usuario {
  id           String   @id @default(uuid())
  nombre       String
  username     String   @unique
  email        String   @unique
  passwordHash String
  rol          Rol      @default(ADMIN)
  activo       Boolean  @default(true)
  empleadoId   String?  @unique
  empleado     Empleado? @relation(fields: [empleadoId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  maquinasCreadas   Maquina[]         @relation("MaquinaCreadaPor")
  intervenciones    Intervencion[]    @relation("RegistradoPor")
  aprobaciones      Intervencion[]    @relation("AprobadoPor")
  historialEstados  HistorialEstado[]
  refreshTokens     RefreshToken[]

  @@map("usuarios")
}

model Empleado {
  id           String       @id @default(uuid())
  nombre       String
  apellido     String
  telefono     String?
  email        String       @unique
  carnet       String?      @unique
  especialidad Especialidad
  activo       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  usuario                   Usuario?
  intervencionesAsignadas   Intervencion[] @relation("EmpleadoAsignado")
  intervencionesFinalizadas Intervencion[] @relation("EmpleadoFinalizo")
  diagnosticosAsignados     Maquina[]      @relation("DiagnosticoAsignado")

  @@map("empleados")
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  usuarioId String
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@map("refresh_tokens")
  @@index([usuarioId])
}

model Proveedor {
  id        String    @id @default(uuid())
  nombre    String
  createdAt DateTime  @default(now())
  maquinas  Maquina[]

  @@map("proveedores")
}

model Cliente {
  id        String   @id @default(uuid())
  nombre    String
  nitCi     String?
  telefono  String?
  notas     String?
  createdAt DateTime @default(now())
  pedidos   Pedido[]
  ventas    Venta[]

  @@map("clientes")
}

model Maquina {
  id                   String        @id @default(uuid())
  nombre               String
  tipo                 String
  marca                String
  modelo               String
  anio                 Int?
  proveedorId          String
  proveedor            Proveedor     @relation(fields: [proveedorId], references: [id])
  estado               EstadoMaquina @default(COMPRADA_ITALIA)
  descripcionLlegada   String?
  descripcionAcordada  String?
  notaAudioUrl         String?
  fechaDespacho        DateTime?
  empleadoDiagnostico  String?
  empleadoDiagnosticoId String?
  empleadoDiag          Empleado?    @relation("DiagnosticoAsignado", fields: [empleadoDiagnosticoId], references: [id])
  precioCompraUsd       Decimal?      @db.Decimal(10, 2)
  precioVentaUsd       Decimal?      @db.Decimal(10, 2)
  tipoCambioUsado      Decimal?      @db.Decimal(10, 4)
  precioVentaBob       Decimal?      @db.Decimal(10, 2)
  fechaCompra          DateTime?
  fechaLlegadaEstimada DateTime?
  fechaLlegadaReal     DateTime?
  creadoPorId          String
  creadoPor            Usuario       @relation("MaquinaCreadaPor", fields: [creadoPorId], references: [id])
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  imagenes         ImagenMaquina[]
  intervenciones   Intervencion[]
  pedidos          Pedido[]
  venta            Venta?
  historialEstados HistorialEstado[]

  @@map("maquinas")
  @@index([estado])
}

model ImagenMaquina {
  id             String        @id @default(uuid())
  maquinaId      String
  maquina        Maquina       @relation(fields: [maquinaId], references: [id], onDelete: Cascade)
  intervencionId String?
  intervencion   Intervencion? @relation(fields: [intervencionId], references: [id], onDelete: SetNull)
  etapa          EtapaImagen
  url            String
  thumbnailUrl   String
  createdAt      DateTime      @default(now())

  @@map("imagenes_maquina")
  @@index([maquinaId])
  @@index([intervencionId])
}

model Intervencion {
  id                 String             @id @default(uuid())
  maquinaId          String
  maquina            Maquina            @relation(fields: [maquinaId], references: [id], onDelete: Cascade)
  tipo               TipoIntervencion
  area               AreaIntervencion
  descripcion        String
  responsableId      String?
  responsable        Empleado?          @relation("EmpleadoAsignado", fields: [responsableId], references: [id])
  responsableNombre  String?
  estadoIntervencion EstadoIntervencion @default(ASIGNADO)
  detalleTrabajo     String?
  observaciones      String?
  fechaAsignacion    DateTime?
  fechaInicio        DateTime?
  fechaFinalizacion  DateTime?
  fechaAprobacion    DateTime?
  aprobadoPorId      String?
  aprobadoPor        Usuario?           @relation("AprobadoPor", fields: [aprobadoPorId], references: [id])
  estadoAprobacion   EstadoAprobacion   @default(PENDIENTE)
  finalizadoPorId    String?
  finalizadoPor      Empleado?          @relation("EmpleadoFinalizo", fields: [finalizadoPorId], references: [id])
  registradoPorId    String
  registradoPor      Usuario            @relation("RegistradoPor", fields: [registradoPorId], references: [id])
  createdAt          DateTime           @default(now())
  imagenes           ImagenMaquina[]

  @@map("intervenciones")
  @@index([maquinaId])
  @@index([responsableId])
  @@index([estadoIntervencion])
}

model HistorialEstado {
  id          String        @id @default(uuid())
  maquinaId   String
  maquina     Maquina       @relation(fields: [maquinaId], references: [id], onDelete: Cascade)
  estado      EstadoMaquina
  anterior    EstadoMaquina?
  motivo      String?
  creadoPorId String
  creadoPor   Usuario       @relation(fields: [creadoPorId], references: [id])
  createdAt   DateTime      @default(now())

  @@map("historial_estados")
  @@index([maquinaId])
}

model Pedido {
  id                    String       @id @default(uuid())
  clienteId             String
  cliente               Cliente      @relation(fields: [clienteId], references: [id])
  maquinaId             String?
  maquina               Maquina?     @relation(fields: [maquinaId], references: [id])
  descripcionReferencia String?
  fotoReferenciaUrl     String?
  anticipoUsd           Decimal      @db.Decimal(10, 2)
  saldoUsd              Decimal      @db.Decimal(10, 2)
  totalUsd              Decimal      @db.Decimal(10, 2)
  fechaEntregaEstimada  DateTime?
  estado                EstadoPedido @default(PENDIENTE)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  reciboReserva ReciboReserva?

  @@map("pedidos")
}

model Venta {
  id             String   @id @default(uuid())
  maquinaId      String   @unique
  maquina        Maquina  @relation(fields: [maquinaId], references: [id])
  clienteId      String
  cliente        Cliente  @relation(fields: [clienteId], references: [id])
  precioFinalUsd Decimal  @db.Decimal(10, 2)
  precioFinalBob Decimal  @db.Decimal(10, 2)
  tipoCambio     Decimal  @db.Decimal(10, 4)
  fechaEntrega   DateTime
  createdAt      DateTime @default(now())

  reciboVenta ReciboVenta?

  @@map("ventas")
}

model ReciboVenta {
  id           String   @id @default(uuid())
  numero       String   @unique
  ventaId      String   @unique
  venta        Venta    @relation(fields: [ventaId], references: [id])
  fechaEmision DateTime @default(now())
  createdAt    DateTime @default(now())

  @@map("recibos_venta")
}

model ReciboReserva {
  id           String   @id @default(uuid())
  numero       String   @unique
  pedidoId     String   @unique
  pedido       Pedido   @relation(fields: [pedidoId], references: [id])
  fechaEmision DateTime @default(now())
  vigenciaDias Int      @default(15)
  createdAt    DateTime @default(now())

  @@map("recibos_reserva")
}
