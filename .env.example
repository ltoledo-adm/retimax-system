# PostgreSQL (Docker Compose)
POSTGRES_USER=retimax
POSTGRES_PASSWORD=retimax_secret
POSTGRES_DB=retimax

# API — desarrollo local (ajusta DATABASE_URL y UPLOAD_DIR)
# DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/retimax
DATABASE_URL=postgresql://retimax:retimax_secret@postgres:5432/retimax
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
UPLOAD_DIR=./uploads
PORT=4000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000

# Seed (solo primera instalación o rotación explícita; no commitear valores reales)
# ADMIN_EMAIL=admin@retimax.local
# ADMIN_USERNAME=admin
# ADMIN_INITIAL_PASSWORD=
